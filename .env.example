# Copiar a .env y completar. NUNCA subir .env al repositorio.
# local | production. En "local" y SOLO sobre http://localhost / 127.0.0.1 las
# cookies van sin Secure ni prefijo __Host-; en production se exige HTTPS.
APP_ENV=local
# URL exacta con la que se accede (esquema, host, puerto y ruta base). La app
# rechaza otros Host y valida el Origin contra ella.
#   php -S 127.0.0.1:8099 -t public public/index.php  ->  http://127.0.0.1:8099
#   Apache con alias                                ->  http://localhost/perfumeria/public
APP_URL=http://127.0.0.1:8099
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sistema_perfu
DB_USER=perf_app
DB_PASS=
DB_CHARSET=utf8mb4
# Secretos: hexadecimal de al menos 64 caracteres (32 bytes), distintos entre si.
# Generar cada uno con:  php -r "echo bin2hex(random_bytes(32));"
# Sin ellos (o si son cortos/iguales) la aplicacion NO arranca (500 generico + log).
JWT_SECRET=
CSRF_SECRET=
# Solo durante una rotacion de JWT_SECRET (acepta tokens firmados con la clave previa
# unos minutos). Dejar vacio normalmente.
JWT_SECRET_ANTERIOR=
# Opcionales (valores por defecto entre parentesis):
#   fallos de login por IP en 15 min antes de bloquearla (20)
LOGIN_MAX_INTENTOS_IP=
#   peticiones a /auth/refresh por IP y minuto (60)
REFRESH_MAX_POR_MINUTO=
STORAGE_PATH=storage/uploads
BACKUP_PATH=backups

# Solo para scripts CLI (migrate.php, backup.php). La app NO debe usar estos.
# Si faltan, los scripts usan DB_USER / DB_PASS.
DB_ADMIN_USER=
DB_ADMIN_PASS=
DB_BACKUP_USER=
DB_BACKUP_PASS=
